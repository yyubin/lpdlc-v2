lpdl 2

# 돈키호테 · 오트쿠튀르::르누아르 브랜드 매니저 고유 키워드

keyword "진동 - 보존" {
  prop kind status
  prop inherit "진동"          # 진동 위력·횟수 증감 효과를 동일하게 적용받음. 폭발 시 위력만큼 흐트러짐 손상, 턴 종료 후 횟수 1 감소도 진동과 같음
  use 진보 = "진동 - 보존"
  on burst(진보) when target == self {
    text """진동 폭발 시 진동 위력의 (60 + 공격자의 충전 위력 또는 특수 충전 × 8)%만큼 나태 피해를 입고 횟수 1 감소 (최대 120%)"""
    hook vibration_preserve_burst_sloth_damage(60, 8, 120)
    note "나태 피해 = pct(self.진보.potency, min(60 + P * 8, 120)). P = 폭발을 일으킨 유닛(ev.source)의 충전 위력 또는 특수 충전 위력. 특수 충전 종류를 일반적으로 조회하는 어휘가 없어 엔진 구현"
  }
  on burst(진보) when target == self and not has_affiliation(ev.source, "르누아르") {
    text """· 르누아르 소속 캐릭터의 스킬, 패시브 효과로 진동 폭발 시 횟수가 감소하지 않음"""
    gain self.진보.count -1
    note "폭발 출처(ev.source)가 르누아르 소속이면 횟수 감소 없음. 스킬·패시브 모두 해당 (R3)"
  }
  on turn_end {
    gain self.진보.count -1
    note "턴 종료 후 횟수 1 감소 — 진동과 같음 (inherit 는 부모 정의의 블록을 물려받지 않아 직접 적음)"
  }
}

keyword "보존 신역" {
  prop kind value
  prop max 5
  use 신역 = "보존 신역"
  always {
    when self.신역 > 0 {
      text """모든 아군 인격: 스킬 사용 시 각 아군의 최대 체력의 (돈키호테의 보존 위력 × 2)%만큼 보호막 얻음 (턴당 1회, 최대 10%)"""
      hook sanctuary_ally_shield_on_skill_use(min(self.보존.potency * 2, 10))
      note "self = 보존 신역 보유자(돈키호테). 아군마다 각자 턴당 1회, 각 아군 자신의 최대 체력 기준"
      modify atk_level floor(self.보존.potency / 3) cap 2 to pick(allies, where: has_affiliation(it, "르누아르"))
      modify def_level floor(self.보존.potency / 2) cap 3 to pick(allies, where: has_affiliation(it, "르누아르"))
      note "'모든 르누아르 소속 인격'은 아군 르누아르 인격으로 해석"
      modify speed_min -1 to enemies
      modify speed_max -1 to enemies
      hook speed_floor(enemies, 1)
      note "이 효과로 적의 속도 최솟값·최댓값이 1 미만이 되지 않음"
      text """충전 횟수 또는 특수 충전을 소모하는 스킬로 받는 피해량 +10% (르누아르 소속 아군 인격의 스킬이면, 대신 2배로 적용)"""
      hook charge_consuming_skill_taken_damage_bonus(enemies, 10, 2)
    }
  }
  on burst(진동) when target is enemy and self.신역 > 0 {
    text """진동 폭발 시 받는 흐트러짐 피해량 +10%"""
    modify stagger_damage_pct 10
  }
  on turn_end {
    gain self.신역 -1
  }
}

keyword "약속된 못" {
  prop kind value
  prop max 30
  use 못 = "약속된 못"
  on burst(진동) when target == self limit 1/use {
    text """스킬 효과로 진동 폭발 시 이 효과 수치 1당, 나태 피해 1 입음 (최대 10, 스킬당 1회)"""
    deal self 나태 min(self.못, 10)
    note "스킬당 1회 = 폭발을 일으킨 스킬 사용 1회당 1회. '스킬 효과로'의 출처 구분(패시브 폭발 제외)은 고정 어휘로 표현 불가 — 엔진이 스킬 효과로 인한 폭발에서만 발동해야 함"
  }
  on turn_end when self.못 >= 4 {
    apply self 속박 potency 1 next_turn
  }
  on turn_start {
    text """턴 시작 시 전장에 오트쿠튀르::르누아르 브랜드 매니저 돈키호테가 없으면, 이 효과 소멸"""
    hook vanish_if_identity_absent(204)
  }
}

keyword "검은 신의 가호" {
  prop kind value
  prop max 100
  use 가호 = "검은 신의 가호"
  on turn_start {
    gain self.shield pct(self.max_hp, floor(self.가호 / 5))
    note "'(수치 / 5)% (소수점 버림)' — 버림을 퍼센트 항(수치/5)에 적용하는 것으로 해석"
  }
  on use when self.가호 >= 25 and skill is basic_attack {
    hook all_coins_unbreakable
  }
  always {
    when self.가호 >= 40 {
      hook stagger_immune("except_forced")
      note "강제 흐트러짐 제외"
    }
  }
}

# 돈키호테 — 오트쿠튀르::르누아르 브랜드 매니저 (동기화 4)
identity 204 "오트쿠튀르::르누아르 브랜드 매니저" {
  use 진보 = "진동 - 보존"
  use 신역 = "보존 신역"
  use 못 = "약속된 못"
  use 가호 = "검은 신의 가호"
  use 공레 = "공격 레벨 증가"
  use 방레 = "방어 레벨 증가"
  budget 가호보존연동 30/turn
  budget 가호피격연동 10/turn

  skill S1 "못 박히라" {
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
      note "진동 참조는 진동 계열(진폭 변환된 진동 - 보존 포함, inherit)로 해석"
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    on use limit 1/turn {
      gain self.충전.count 4
      gain self.충전.count 4 to pick(allies, where: it != self and has_affiliation(it, "르누아르"), by: it.충전.count, n: 1)
      note "자신은 보존(충전 inherit)으로 충전 횟수 증가를 적용받음. to = 고른 아군 자신의 충전 횟수 증가"
    }
    coin 1 {
      on hit { gain target.진동.count 2 }
    }
    coin 2 {
      on hit { gain self.보존.count 6 }
    }
  }

  skill S1 variant 1 "심판!" {
    flag unclashable
    always {
      hook no_defense_skill_trigger
      hook no_external_reuse
      hook target_hp_floor_until_skill_end(1)
      note "수비 스킬을 발동시키지 않음 / 외부 효과로 재사용 불가 / 이 스킬 종료 시까지 대상 체력이 1 미만으로 감소하지 않음"
    }
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
  }

  skill S2 "못 생기라" {
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 30
    }
    on before_attack {
      modify final_power per(team.max_resonance, 1) cap 4 coins last
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
    coin 2 {
      on hit { gain self.보존.count 8 }
      on hit { gain target.진동.count 3 }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill S3 "탄생을 끊으리라!" {
    on combat_start limit 1/turn {
      gain self.신역 3
    }
    on combat_start limit 1/turn {
      apply self 공레 potency 2
      apply self 방레 potency 2
      let a = pick(allies, where: it != self and has_affiliation(it, "르누아르"), by: it.speed, desc: 1, n: 1)
      apply a 공레 potency 2
      apply a 방레 potency 2
    }
    on use {
      modify coin_power per(target.진동.potency + target.못, 6) cap 2
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    on before_attack {
      modify final_power per(team.max_resonance, 1) cap 4 coins last
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
    coin 2 {
      on hit { gain target.진동.count 3 }
    }
    coin 3 {
      on hit { gain self.보존.count 4 }
      on hit {
        retype target 진동 -> 진보
        note "진폭 변환: 진동 또는 변경된 진동을 진동 - 보존으로, 위력·횟수 유지"
      }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit when target.못 >= 3 {
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill S3 variant 1 "거듭 내리쳐, 탄생을 끊으리라!" {
    always {
      hook treat_as_attack_skill_when_replacing_defense
      note "수비 스킬 대신 발동해도 공격 스킬로 취급: 수비 위력 변경 효과 미적용, 공격 위력 변경 효과 적용"
    }
    on combat_start limit 1/turn {
      apply pick(allies, where: has_affiliation(it, "르누아르")) 공레 potency 2
      apply pick(allies, where: has_affiliation(it, "르누아르")) 방레 potency 2
    }
    on use {
      text """[사용시] 모든 공격 대상의 진동 위력과 약속된 못의 합 6당, 코인 위력 +1 (최대 2)"""
      hook coin_power_per_all_targets_vibration_nail_sum(6, 2)
      note "모든 공격 대상의 (진동 위력 + 약속된 못)을 합산 — 대상 목록 합계 어휘가 없어 엔진 구현"
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
    }
    on use {
      text """[사용시] 이 스킬 공격 가중치보다 낮은 공격 대상 1당, 피해량 +50% (집중 전투인 경우, 부위로 판정)"""
      hook damage_pct_per_targets_below_weight(50)
    }
    on before_attack {
      modify final_power per(team.max_resonance, 1) * 2 cap 8 coins last
    }
    on attack_end {
      consume self.가호 all
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 2 }
    }
    coin 2 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 2 }
    }
    coin 3 {
      on hit { gain target.진동.count 3 }
      on hit limit 1/use {
        gain self.보존.count 4
        note "코인당 1회 = 이 코인이 여러 대상에 적중해도 스킬 사용 중 1회"
      }
      on hit {
        retype target 진동 -> 진보
      }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit {
        let m = target.못
        when m >= 3 {
          burst target 진동
          gain target.진동.count -1
        }
        deal target 나태 pct(coin.final_damage, min(m * 3, 90))
        consume target.못 all
        note "대상별로 적용 — 적중한 각 대상의 약속된 못 수치 기준"
      }
    }
  }

  skill DEF "묵시" {
    on combat_start limit 1/turn {
      gain self.신역 3
    }
    on combat_start limit 1/turn {
      gain self.sanity 6
      gain self.sanity 6 to pick(allies, where: it != self and has_affiliation(it, "르누아르"), by: it.sanity, n: 1)
      note "to = 고른 아군 자신의 정신력 회복"
    }
    on combat_start when self.가호 == 100 limit 1/turn {
      replace this -> S3 variant 1
      hook trigger_on_one_sided_attack
      note "이 효과는 일방 공격에도 발동함. '대신' — 100 미만 분기와 배타적이며 각 분기는 원문대로 별도 턴당 1회"
    }
    on combat_start when self.가호 < 100 limit 1/turn {
      gain self.shield pct(self.max_hp, self.가호 / 10)
    }
    on combat_start limit 1/turn {
      gain self.보존.count 4
    }
    on use {
      modify coin_power per(target.진동.potency + target.못, 6) cap 2
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 20
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { gain target.진동.count 2 }
    }
    coin 2 {
      on hit { gain self.보존.count 4 }
    }
  }

  passive "검은 언약" {
    requires hold [오만, 질투, 나태] 3
    on combat_end when self.신역 > 0 {
      apply self 신속 potency 2 next_turn
    }
    on use when skill is basic_attack and target is main_target {
      modify damage_pct self.보존.potency * 6 cap 30
      note "메인 타겟에게 가하는 피해에만 적용 (다중 대상 시 다른 대상 제외)"
    }
  }

  passive "말레우스 프로미시오니스" {
    on stage_enter limit 1/battle {
      gain self.보존.count 10
      gain self.충전.count 2 to pick(allies, where: it != self and has_affiliation(it, "르누아르"))
      note "스테이지 첫 등장 시 = 전투당 1회. to = 자신을 제외한 르누아르 아군 각자의 충전 횟수 증가"
    }
    on applied(못) by self {
      when self.보존.count >= 12 {
        modify amount 1
        consume self.보존.count 4
        hook mark_skill_as_charge_consuming
      } elif self.보존.count >= 2 {
        consume self.보존.count 2
        hook mark_skill_as_charge_consuming
      } else {
        modify amount -ev.amount
      }
      note "스킬 효과로 부여 시 — 이 인격은 스킬로만 약속된 못을 부여. 보존 횟수 부족(2 미만)이면 대신 부여하지 않음(부여량 0). 소모가 일어난 스킬은 충전 횟수를 소모하는 스킬로 취급"
    }
    on consumed(self.보존.count) every 10 {
      gain self.보존.potency 1
    }
  }

  passive "보존의 사명" {
    on stage_enter limit 1/battle {
      gain self.가호 25
    }
    on consumed(self.보존.count) {
      gain self.가호 ev.amount * 5 budget 가호보존연동
    }
    on gained(self.보존.count) when ev.overflow > 0 {
      gain self.가호 ev.overflow * 5 budget 가호보존연동
      note "'자신의'는 보존 횟수의 소유자 — 출처 제한 없음. 소모·초과 획득이 턴당 최대 30을 공유"
    }
    on ally_hit_taken when target.shield > 0 {
      when keyword_identity(target, 충전) {
        gain self.가호 5 budget 가호피격연동
      } else {
        gain self.가호 2 budget 가호피격연동
      }
      note "'대신' = 충전 인격이면 2 대신 5. 턴당 최대 10을 공유"
    }
  }

  passive "신의 뜻과 가치가 우리와 함께하리…" {
    on ally_before_attack when target != self and has_affiliation(target, "르누아르") limit 1/turn {
      use_skill S1 variant 1 on pick(enemies, prefer: it is main_target, n: 1)
      note "'적에게 공격 시작 전' — 적 대상 공격으로 해석. main_target = 그 아군 공격의 메인 타겟. 심판!은 합 불가능 → 일방 공격"
    }
    on use when skill is basic_skill {
      text """기본 스킬의 마지막 코인 시작 시 (자신의 보존 위력 + 대상의 약속된 못/2)만큼 해당 코인의 최종 위력이 증가함 (최대 5)"""
      hook last_coin_start_final_power(self.보존.potency + target.못 / 2, 5)
      note "식은 마지막 코인 시작 시점에 평가. '코인 시작 시' 이벤트가 없어 엔진 구현. 위력 정수 처리는 엔진"
    }
    on use when self.신역 > 0 {
      when skill is S1 or skill is S1 variant 1 {
        modify clash_power 1
      } elif skill is S2 {
        modify clash_power 2
      } elif skill is S3 or skill is S3 variant 1 {
        modify clash_power 3
      }
      note "기본 스킬 1/2/3 에 해당 슬롯의 변형 스킬 포함으로 해석"
    }
    on burst(진동) when target.못 > 0 limit 2/turn {
      gain self.충전.count 2
      gain self.충전.count 2 to pick(allies, where: it != self and keyword_identity(it, 충전), by: it.충전.count, n: 1)
      note "진동 폭발 출처 무관('발생 시'). 자신은 보존(충전 inherit)으로 적용받음. to = 고른 아군 자신의 충전 횟수 증가"
    }
  }

  support "진형 보존" {
    on combat_start {
      let n = count_of(allies, keyword_identity(it, 충전))
      modify taken_damage_pct max(-2 * n, -10) this_turn to pick(allies, where: keyword_identity(it, 충전))
    }
  }
}
