lpdl 2

# 돈키호테 — 오트쿠튀르::르누아르 브랜드 매니저 (동기화 4) 고유 키워드

keyword "진동 - 보존" {
  prop kind status
  prop inherit "진동"
  use 진동보존 = "진동 - 보존"
  # inherit 진동: 진동 폭발 시 위력만큼 흐트러짐 손상, 턴 종료 후 횟수 1 감소, 진동 위력·횟수 증감 효과를 동일하게 적용받음
  on burst(진동보존) {
    text """진동 폭발 시 진동 위력의 (60 + 공격자의 충전 위력 또는 특수 충전 × 8)%만큼 나태 피해를 입고 횟수 1 감소 (최대 120%)"""
    text """· 르누아르 소속 캐릭터의 스킬, 패시브 효과로 진동 폭발 시 횟수가 감소하지 않음"""
    hook vibration_preservation_burst(60, 8, 120)
    note "나태 피해는 피해 유형 어휘에 없음. 공격자의 충전 위력이나 특수 충전 위력은 식으로 참조할 수 없음. 르누아르 소속 출처도 식으로 판정할 수 없음 → 피해와 횟수 1 감소(르누아르 예외 포함)를 엔진 hook 으로 처리"
  }
}

keyword "보존 신역" {
  prop kind value
  prop max 5
  use 신역 = "보존 신역"
  # 보유자 = 돈키호테(self). '돈키호테의 보존 위력' = self.보존.potency
  always {
    text """모든 아군 인격: 스킬 사용 시 각 아군의 최대 체력의 (돈키호테의 보존 위력 × 2)%만큼 보호막 얻음 (턴당 1회, 최대 10%)"""
    hook allies_on_use_shield_pct(min(self.보존.potency * 2, 10))
    text """모든 르누아르 소속 인격: 공격 레벨 +(보존 위력 / 3) (소수점 버림, 최대 2), 방어 레벨 +(보존 위력 / 2) (소수점 버림, 최대 3)"""
    hook renoir_allies_atk_level(min(floor(self.보존.potency / 3), 2))
    hook renoir_allies_def_level(min(floor(self.보존.potency / 2), 3))
    text """모든 적: 속도 최솟값, 최댓값 -1 (이 효과로 속도 최솟값, 최댓값이 1 미만이 되지 않음)"""
    hook enemies_speed_range_down(1, 1)
    text """모든 적: 진동 폭발 시 받는 흐트러짐 피해량 +10%"""
    hook enemies_burst_stagger_taken_pct(10)
    text """모든 적: 충전 횟수 또는 특수 충전을 소모하는 스킬로 받는 피해량 +10% (르누아르 소속 아군 인격의 스킬이면, 대신 2배로 적용)"""
    hook enemies_charge_skill_taken_damage_pct(10, 2)
    note "아군·르누아르 소속·적 같은 다른 유닛에 거는 오라 효과는 고정 어휘로 대상을 지정할 수 없음 → 엔진 hook"
  }
  on turn_end {
    gain self.신역 -1
  }
}

keyword "약속된 못" {
  prop kind value
  prop max 30
  use 못 = "약속된 못"
  on burst(진동) limit 1/use {
    text """스킬 효과로 진동 폭발 시 이 효과 수치 1당, 나태 피해 1 입음 (최대 10, 스킬당 1회)"""
    hook promised_nail_burst_sin_damage("나태", min(self.못, 10))
    note "나태 피해는 피해 유형 어휘에 없음. '스킬 효과로'(패시브 제외) 판정도 hook 이 처리함. 진동 - 보존처럼 진동을 inherit 하는 키워드의 폭발도 포함"
  }
  on turn_end when self.못 >= 4 {
    apply self 속박 potency 1 next_turn
  }
  on turn_start {
    text """턴 시작 시 전장에 오트쿠튀르::르누아르 브랜드 매니저 돈키호테가 없으면, 이 효과 소멸"""
    hook remove_unless_identity_on_field(204, "약속된 못")
  }
}

keyword "검은 신의 가호" {
  prop kind value
  prop max 100
  use 가호 = "검은 신의 가호"
  on turn_start {
    gain self.shield pct(self.max_hp, floor(self.가호 / 5))
  }
  on use when self.가호 >= 25 and skill is basic_attack {
    text """수치가 25 이상이면, 기본 공격 스킬 사용 시 모든 코인이 파괴 불가 코인이 됨"""
    hook make_all_coins_unbreakable()
  }
  always {
    text """수치가 40 이상이면, 자신은 흐트러짐 상태가 되지 않음 (강제 흐트러짐 제외)"""
    hook stagger_immune_unless_forced(self.가호 >= 40)
  }
}

# 원문: gesellschaft DB (baslimbus)
identity 204 "오트쿠튀르::르누아르 브랜드 매니저" {
  use 가호 = "검은 신의 가호"
  use 신역 = "보존 신역"
  use 못 = "약속된 못"
  use 진동보존 = "진동 - 보존"
  use 공격레벨증가 = "공격 레벨 증가"
  use 방어레벨증가 = "방어 레벨 증가"
  budget 사명 30/turn
  budget 가호피격 10/turn

  skill S1 "못 박히라" {
    # '대상의 진동 위력': 진동 - 보존은 inherit 진동이므로 target.진동 참조에 포함됨
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    on use limit 1/turn {
      text """[사용시] 자신과 자신을 제외한 충전 횟수가 가장 적은 르누아르 소속 아군 인격 1명의 충전 횟수 4 증가 (턴당 1회)"""
      gain self.충전.count 4
      hook renoir_ally_lowest_charge_gain_charge_count(4)
      note "자신은 보존(inherit 충전)을 보유하므로 충전 횟수 증가는 엔진이 보존 횟수로 적용함. 르누아르 소속 판정과 충전 횟수 기준 선택은 식으로 표현할 수 없음 → hook"
    }
    coin 1 {
      on hit { gain target.진동.count 2 }
    }
    coin 2 {
      on hit { gain self.보존.count 6 }
    }
  }

  skill S1 variant 1 "심판!" {
    flag unclashable
    always {
      text """이 스킬은 아래 효과가 적용됨 - 수비 스킬을 발동시키지 않음 - 외부 효과로 재사용할 수 없음 - 이 스킬 종료 시까지 대상의 체력이 1 미만으로 감소하지 않음"""
      hook no_defense_skill_trigger()
      hook no_external_reuse()
      hook target_hp_floor_until_skill_end(1)
    }
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
  }

  skill S2 "못 생기라" {
    on use {
      modify final_power per(target.진동.potency + target.못, 4) cap 3
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 30
    }
    on before_attack {
      text """[공격 시작 전] 최대 공명 수 1당, 마지막 코인의 최종 위력 +1 (최대 4)"""
      hook last_coin_final_power_per_max_resonance(1, 4)
      note "최대 공명 수는 식으로 참조할 수 없음 → hook"
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
    coin 2 {
      on hit { gain self.보존.count 8 }
      on hit { gain target.진동.count 3 }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill S3 "탄생을 끊으리라!" {
    on combat_start limit 1/turn {
      gain self.신역 3
    }
    on combat_start limit 1/turn {
      text """[전투 시작시] 자신과 자신을 제외한 속도가 가장 빠른 르누아르 소속 아군 인격 1명에게 공격 레벨 증가 2, 방어 레벨 증가 2 부여 (턴당 1회)"""
      apply self 공격레벨증가 potency 2
      apply self 방어레벨증가 potency 2
      hook renoir_ally_fastest_apply_levels(2, 2)
      note "르누아르 소속 판정은 식으로 표현할 수 없음 → 다른 아군 1명을 고르고 부여하는 부분은 hook"
    }
    on use {
      modify coin_power per(target.진동.potency + target.못, 6) cap 2
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 40
    }
    on before_attack {
      hook last_coin_final_power_per_max_resonance(1, 4)
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 4 }
    }
    coin 2 {
      on hit { gain target.진동.count 3 }
    }
    coin 3 {
      on hit { gain self.보존.count 4 }
      on hit {
        text """[적중시] 진동 - 보존으로 진폭 변환"""
        hook amplitude_convert(target, "진동 - 보존")
        note "진폭 변환은 진동이나 이미 변경된 진동 유형 전부를 대상으로 하고 위력·횟수를 유지함. 원래 유형이 정해져 있지 않으므로 convert 대신 hook"
      }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit when target.못 >= 3 {
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill S3 variant 1 "거듭 내리쳐, 탄생을 끊으리라!" {
    always {
      text """이 스킬은 수비 스킬 대신 발동해도 공격 스킬로 취급되어, 수비 위력 변경 효과를 받지 않고, 공격 위력 변경 효과가 적용됨"""
      hook treat_as_attack_skill_when_replacing_defense()
    }
    on combat_start limit 1/turn {
      text """[전투 시작시] 모든 르누아르 소속 아군 인격에게 공격 레벨 증가 2, 방어 레벨 증가 2 부여 (턴당 1회)"""
      hook renoir_allies_apply_levels(2, 2)
      note "르누아르 소속 판정 불가 → hook (자신 포함)"
    }
    on use {
      text """[사용시] 모든 공격 대상의 진동 위력과 약속된 못의 합 6당, 코인 위력 +1 (최대 2)"""
      hook coin_power_per_all_targets_vibration_nail_sum(6, 2)
      note "모든 공격 대상에 대해 합산하는 함수가 없음 → hook"
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
    }
    on use {
      text """[사용시] 이 스킬 공격 가중치보다 낮은 공격 대상 1당, 피해량 +50% (집중 전투인 경우, 부위로 판정)"""
      hook damage_pct_per_target_below_attack_weight(50)
    }
    on before_attack {
      hook last_coin_final_power_per_max_resonance(2, 8)
    }
    on attack_end {
      consume self.가호 all
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 2 }
    }
    coin 2 {
      on hit { apply target 못 potency 1 }
      on hit { apply target 진동 potency 2 }
    }
    coin 3 {
      on hit { gain target.진동.count 3 }
      on hit limit 1/use {
        gain self.보존.count 4
        note "'코인당 1회': 이 코인은 한 번 사용할 때 1회만 진행되므로 limit 1/use 와 같음 (여러 대상을 적중해도 1회)"
      }
      on hit { hook amplitude_convert(target, "진동 - 보존") }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit {
        text """[적중시] 대상별로 약속된 못 수치에 따라 아래 효과 적용"""
        when target.못 >= 3 {
          burst target 진동
          gain target.진동.count -1
        }
        hook sin_damage(target, "나태", pct(coin.final_damage, min(target.못 * 3, 90)))
        consume target.못 all
        note "나태 피해는 피해 유형 어휘에 없음 → hook. 하위 항목을 적힌 순서대로 적용함 (못 소모는 피해 계산 뒤)"
      }
    }
  }

  skill DEF "묵시" {
    on combat_start limit 1/turn {
      gain self.신역 3
    }
    on combat_start limit 1/turn {
      text """[전투 시작시] 자신과 자신을 제외한 정신력이 가장 낮은 르누아르 소속 아군 인격 1명의 정신력 6 회복 (턴당 1회)"""
      gain self.sanity 6
      hook renoir_ally_lowest_sanity_heal(6)
    }
    # 다음 [전투 시작시] 문단의 하위 항목은 하나의 효과지만 항목마다 턴당 1회가 따로 붙어 있음
    # → 서로 배타적인 조건의 두 블록으로 나눔 (100 = 최댓값이므로 >= 100)
    on combat_start when self.가호 >= 100 limit 1/turn {
      text """- 100이면, 대신 ‘거듭 내리쳐, 탄생을 끊으리라!’로 발동됨 (턴당 1회, 이 효과는 일방 공격에도 발동함)"""
      replace this -> S3 variant 1
      hook trigger_on_one_sided_attack()
      note "'일방 공격에도 발동함'은 일방 공격 상황에서도 이 전환을 평가하라는 뜻 → hook"
    }
    on combat_start when self.가호 < 100 limit 1/turn {
      gain self.shield pct(self.max_hp, self.가호 / 10)
    }
    on combat_start limit 1/turn {
      gain self.보존.count 4
    }
    on use {
      modify coin_power per(target.진동.potency + target.못, 6) cap 2
    }
    on use when self.보존.potency >= 3 {
      modify coin_power 1
      modify damage_pct 20
    }
    coin 1 {
      on hit { apply target 못 potency 1 }
      on hit { gain target.진동.count 2 }
    }
    coin 2 {
      on hit { gain self.보존.count 4 }
    }
  }

  passive "검은 언약" {
    requires hold [오만, 질투, 나태] 3
    on turn_end when self.신역 >= 1 {
      apply self 신속 potency 2 next_turn
      note "'전투 종료 시' 이벤트가 없어 turn_end 로 씀. 보존 신역의 턴 종료 감소보다 먼저 평가해야 함. '있으면' = 1 이상"
    }
    on use when skill is basic_attack {
      text """자신의 기본 공격 스킬로 메인 타겟에게 가하는 피해량 +(자신의 보존 위력 x 6)% (최대 30%)"""
      hook main_target_damage_pct(min(self.보존.potency * 6, 30))
      note "메인 타겟 한정 조건은 식으로 표현할 수 없음 → hook"
    }
  }

  passive "말레우스 프로미시오니스" {
    on stage_enter limit 1/battle {
      text """스테이지 첫 등장 시 자신의 보존 횟수 10 증가하고, 자신을 제외한 르누아르 소속 아군 인격의 충전 횟수 2 증가"""
      gain self.보존.count 10
      hook renoir_allies_gain_charge_count(2)
      note "'첫 등장' → limit 1/battle (전투 = 스테이지 단위로 해석). 다른 르누아르 아군은 판정할 수 없음 → hook"
    }
    on applied(못) by self {
      text """스킬 효과로 약속된 못 부여 시 자신의 보존 횟수가 12 이상이면 부여량 +1, 보존 횟수 4 소모 / 12 미만이면 보존 횟수 2 소모 / 부족하면 대신 부여하지 않음"""
      when self.보존.count >= 12 {
        modify amount 1
        consume self.보존.count 4
      } else {
        consume self.보존.count 2 -> c
        when c == 0 {
          modify amount 0 - ev.amount
        }
      }
      note "약속된 못은 이 인격의 스킬로만 부여되므로 by self 로 씀. '부족하면' = 2 미만 → consume N 의 결과가 0이면 부여량을 0으로 만들어 부여하지 않음"
    }
    always {
      text """- 이 효과로 인해서 약속된 못을 부여하는 스킬이 충전 횟수를 소모하는 스킬로 취급됨"""
      hook nail_applying_skills_count_as_charge_consuming()
    }
    on consumed(self.보존.count) every 10 {
      gain self.보존.potency 1
    }
  }

  passive "보존의 사명" {
    on stage_enter limit 1/battle {
      gain self.가호 25
    }
    on consumed(self.보존.count) {
      gain self.가호 ev.amount * 5 budget 사명
    }
    on gained(self.보존.count) {
      text """자신의 보존 횟수를 ... 최대치를 초과하여 얻으면, (해당 수치 x 5)만큼 검은 신의 가호 얻음 (턴당 최대 30)"""
      hook gain_on_overflow("검은 신의 가호", 5, "사명")
      note "획득량 중 최대치(20)를 넘은 부분은 식으로 구할 수 없음 → hook. 턴당 최대 30은 소모분과 함께 씀 (budget 사명)"
    }
    always {
      text """보호막이 있는 아군 인격이 피격 시 자신이 검은 신의 가호 2 얻음 (턴당 최대 10) - 해당 아군 인격이 충전 인격이면, 대신 검은 신의 가호 5 얻음"""
      hook shielded_ally_hit_taken_gain("검은 신의 가호", 2, 5, "가호피격")
      note "아군 피격 이벤트와 충전 인격 판정이 어휘에 없음 → hook (턴당 상한은 budget 가호피격)"
    }
  }

  passive "신의 뜻과 가치가 우리와 함께하리…" {
    on ally_attack {
      text """자신을 제외한 르누아르 소속 아군 인격이 적에게 공격 시작 전, 자신이 ‘심판!’으로 메인 타겟을 우선으로 일방 공격함 (턴당 1회)"""
      hook follow_up_attack_before_renoir_ally("심판!", "main_target_first", 1)
      note "르누아르 소속 판정 불가 → hook. 조건에 맞을 때만 횟수를 세야 하므로 턴당 1회도 hook 이 관리함. 시점은 아군의 [공격 시작 전]. 첫 인자 '심판!' = S1 variant 1"
    }
    on before_attack when skill is basic_skill {
      text """기본 스킬의 마지막 코인 시작 시 (자신의 보존 위력 + 대상의 약속된 못/2)만큼 해당 코인의 최종 위력이 증가함 (최대 5)"""
      hook last_coin_start_final_power_bonus("self.보존.potency + target.못 / 2", 5)
      note "앞선 코인이 부여한 못을 반영하려면 마지막 코인이 시작하는 시점의 값으로 계산해야 함. 패시브 범위에서는 마지막 코인을 판정할 수 없음 → hook. 원문에 반올림 방식이 없어 지정하지 않음"
    }
    on use when self.신역 >= 1 {
      when skill is S1 {
        modify clash_power 1
      } elif skill is S2 {
        modify clash_power 2
      } elif skill is S3 or skill is S3 variant 1 {
        modify clash_power 3
      }
      note "'기본 스킬 3'에 S3 variant 1(스킬 3의 변형)을 포함함. S1 variant 1은 합 불가능이므로 무관"
    }
    on burst(진동) when target.못 >= 1 limit 2/turn {
      text """약속된 못이 있는 대상에게 진동 폭발 발생 시 자신과 자신을 제외한 충전 횟수가 가장 적은 아군 충전 인격 1명의 충전 횟수 2 증가 (턴당 2회)"""
      gain self.충전.count 2
      hook charge_ally_lowest_charge_gain_charge_count(2)
      note "'발생 시'는 폭발 주체를 한정하지 않으므로 by 없음. 자신의 충전 횟수 증가는 보존 inherit 으로 보존 횟수에 적용됨"
    }
  }

  support "진형 보존" {
    on combat_start {
      text """전투 시작 시 전장에 있는 아군 충전 인격 1명당, 이번 턴에 모든 아군 충전 인격이 받는 피해량 -2% (최소 -10%)"""
      hook charge_allies_taken_damage_pct_per_count(-2, -10, "this_turn")
      note "'충전 인격'(인격 분류) 판정과 다른 아군의 받는 피해량 수정은 어휘로 표현할 수 없음 → hook"
    }
  }
}
