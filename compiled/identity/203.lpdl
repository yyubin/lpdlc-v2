lpdl 2

# 로쟈 계열 인격 고유 키워드 (원문: 게임 키워드 사전)

keyword "표류 관성" {
  prop kind special_charge
  prop count_max 20
  prop inherit "충전"          # 충전 위력·횟수 증감 효과를 동일하게 적용받음
  use 표류 = "표류 관성"
  on turn_end {
    gain self.표류.count -1
  }
}

keyword "두 가위" {
  prop kind value
  prop max 1
  use 두가위 = "두 가위"
  always {
    modify atk_level 3
    modify def_level 3
  }
  on use when keyword_identity(self, 충전) limit 1/turn {
    gain self.sanity 5
  }
  on hit when skill is basic_skill {
    text """기본 스킬 적중시, 해당 코인 최종 피해량의 5%만큼 참격 피해"""
    hook hit_coin_final_damage_extra("slash", 5)
    note "coin.final_damage 는 코인 블록 안에서만 쓸 수 있어 키워드 블록에서는 엔진 구현으로 넘김"
  }
  on turn_end {
    consume self.두가위 all
    note "턴 종료 시 소멸"
  }
}

keyword "마름질 표식" {
  prop kind value
  prop max 2
  on dead limit 3/turn {
    text """이 효과를 보유한 대상이 사망 시, 이 효과 부여자가 정신력을 5 회복하고 다음 턴에 공격 레벨 증가 1 얻음(턴당 3회)"""
    hook reward_mark_applier(5, 1)
    note "부여자 참조는 고정 어휘에 없음 → 엔진 구현. 턴당 3회는 부여자 기준 상한으로 해석"
  }
}

keyword "꽃가위" {
  prop kind value
  prop max 2
  always {
    modify damage_flat self.꽃가위 * 7
  }
}

# 로쟈 — 오트쿠튀르::수선실 (동기화 4)
identity 203 "오트쿠튀르::수선실" {
  use 표류 = "표류 관성"
  use 두가위 = "두 가위"
  use 마름질 = "마름질 표식"
  use 공레 = "공격 레벨 증가"
  use 공위 = "공격 위력 증가"

  skill S1 "르투슈(Retouche)" {
    flag unclashable
    flag fixed_target
    flag ally_target
    note "양극성 = 아군 지정 가능(flag ally_target). 자동 지정 시 편성 순서가 가장 빠른 아군 우선, 아군 대상이면 비적중·수비 미발동, 전투 시작 시 발동 → 엔진의 양극성 처리"
    always {
      text """양극성"""
      hook polarity()
    }
    on attack_end when target is ally {
      gain target.충전.count 4
      apply target 공레 potency 1
    }
    on attack_end when target is ally limit 2/turn {
      gain self.shield max(pct(self.max_hp, 10), 1) to target
      apply target 두가위 potency 1
      when keyword_identity(target, 충전) {
        apply target 공위 potency 2
      }
    }
  }

  skill S1 variant 1 "패턴 따기" {
    flag unclashable
    on use {
      gain self.표류.count 3
    }
    coin 1 {
      on hit when self.표류.potency >= 3 limit 1/use {
        reuse_coin
      }
      on hit { gain target.진동.count 1 }
      on hit { apply target 마름질 potency 1 }
    }
  }

  skill S2 "고정 그리고 패턴 따라 재단" {
    on combat_start limit 1/turn {
      text """[전투 시작시] 자신과 자신을 제외한 편성 순서가 가장 빠른 아군 (충전 인격 우선) 1명, 현재 체력 비율이 가장 낮은 아군 1명에게 공격 레벨 증가 2, 자신의 최대 체력의 5%만큼 보호막 부여 (최소 1. 턴당 1회)"""
      note "'자신을 제외한'은 두 아군 선택 모두에 걸리는 것으로 해석. 두 선택이 같은 아군이어도 원문대로 각각 적용"
      let a = pick(allies, where: it != self, prefer: keyword_identity(it, 충전), by: it.formation, n: 1)
      let b = pick(allies, where: it != self, by: it.hp_ratio, n: 1)
      let x = max(pct(self.max_hp, 5), 1)
      apply [self, a, b] 공레 potency 2
      gain self.shield x to [self, a, b]
      when keyword_identity(self, 충전) {
        apply self 공레 potency 1
        gain self.shield x
      }
      when keyword_identity(a, 충전) {
        apply a 공레 potency 1
        gain self.shield x to a
      }
      when keyword_identity(b, 충전) {
        apply b 공레 potency 1
        gain self.shield x to b
      }
    }
    on use {
      modify coin_power per(target.진동.potency, 6) cap 2
    }
    on use {
      consume self.표류.count 5 -> n
      when n > 0 {
        modify final_power 2
      }
    }
    coin 1 {
      on hit { gain self.표류.count 6 }
    }
    coin 2 {
      on hit { gain target.진동.count 2 }
    }
    coin 3 {
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit limit 1/turn {
        text """[적중시] 나태 내성 약화 1 부여 (턴당 1회)"""
        hook apply_named_status("나태 내성 약화", 1)
        note "'나태 내성 약화'가 키워드 어휘에 없어 부여를 엔진 구현으로 넘김"
      }
    }
  }

  skill S2 variant 1 "오려내기" {
    flag unclashable
    on use {
      modify final_power per(self.표류.potency, 3) cap 2
    }
    on use {
      gain self.표류.count 5
    }
    on attack_end {
      consume target.마름질 2
      note "'2 소모'를 문자 그대로 옮김. 이 스킬은 대상의 마름질 표식이 2 이상일 때만 발동되므로 실질 차이 없음"
    }
    on attack_end {
      gain self.꽃가위 1
    }
    coin 1 {
      on hit { apply target 진동 potency 3 }
    }
    coin 2 {
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill S3 "쿠페 당 르 비에" {
    always {
      modify damage_pct self.꽃가위 * 30 cap 60
    }
    on combat_start limit 1/turn {
      text """[전투 시작시] 자신과 자신을 제외한 편성 순서가 가장 빠른 아군 (충전 인격 우선) 1명, 현재 체력 비율이 가장 낮은 아군 1명에게 두 가위 1을 부여하고, 자신의 최대 체력의 10%만큼 보호막 부여 (최소 1. 턴당 1회)"""
      note "'자신을 제외한'은 두 아군 선택 모두에 걸리는 것으로 해석"
      let a = pick(allies, where: it != self, prefer: keyword_identity(it, 충전), by: it.formation, n: 1)
      let b = pick(allies, where: it != self, by: it.hp_ratio, n: 1)
      apply [self, a, b] 두가위 potency 1
      gain self.shield max(pct(self.max_hp, 10), 1) to [self, a, b]
    }
    on use {
      modify coin_power per(target.진동.potency, 6) cap 2
    }
    on use {
      modify final_power per(self.표류.potency, 3) cap 2
    }
    on use {
      consume self.표류.count 5 -> n
      when n > 0 {
        modify final_power 2
      }
    }
    on attack_end {
      gain self.표류.count 5
    }
    coin 1 {
      on hit { gain target.진동.count 3 }
      on hit { apply target 마름질 potency 1 }
    }
    coin 2 {
      on hit { apply target 진동 potency 3 }
    }
    coin 3 {
      on hit { apply target 마름질 potency 1 }
      on hit {
        burst target 진동
        gain target.진동.count -1
      }
      on hit when self.표류.count >= 5 {
        consume self.표류.count 5
        burst target 진동
        gain target.진동.count -1
      }
    }
  }

  skill DEF "트리밍" {
    flag clashable_counter
    on combat_start limit 2/turn {
      gain self.표류.count 5
    }
    on combat_start limit 1/turn {
      let c = pick(allies, where: it != self, by: it.hp_ratio, n: 2)
      gain self.shield max(pct(self.max_hp, 10), 1) to [self, c]
      note "자신 + 자신을 제외한 현재 체력 비율이 가장 낮은 아군 2명"
    }
    on use {
      modify clash_power per(self.표류.count, 5) cap 4
    }
    coin 1 {
      on hit { apply target 진동 potency 2 }
    }
  }

  passive "수선실의 꽃가위 소리" {
    requires hold [나태, 질투] 2
    on turn_end {
      gain self.shield self.표류.count next_turn
    }
    on use when skill is basic_skill {
      when self.표류.potency >= 5 {
        modify final_power 3
      } elif self.표류.potency >= 3 {
        modify final_power 2
      } elif self.표류.potency >= 2 {
        modify final_power 1
      }
    }
  }

  passive "표류 관성" {
    on consumed(self.표류.count) every 10 {
      gain self.표류.potency 1
    }
    on ally_attack_end when target != self and has(target, 두가위) limit 1/turn {
      text """자신을 제외한 두 가위를 보유한 아군의 공격 종료시 대상에게 '패턴 따기' 발동 (턴당 1회)"""
      hook use_skill_on_ally_attack_target("S1", 1)
      note "ally_attack_end 의 target 은 그 아군이라 아군이 공격한 대상을 참조할 수 없음 → 엔진 구현 (S1 variant 1 '패턴 따기' 발동)"
    }
    on before_use when skill is S1 variant 1 and target.마름질 >= 2 limit 1/turn {
      text """- [사용전] 발동 대상의 마름질 표식이 2 이상이면 대신 '오려내기'로 발동 (턴당 1회)"""
      replace this -> S2 variant 1
      note "패턴 따기는 덱에 없고 이 패시브로만 발동되므로 skill is S1 variant 1 로 한정"
    }
  }

  support "한 가위" {
    requires hold [나태] 4
    on use by pick(allies, by: it.speed, desc: 1, n: 1) when skill is basic_skill {
      text """속도가 가장 빠른 아군 1명의 참격 기본 스킬 피해량 +10%"""
      hook damage_pct_if_attack_type("slash", 10)
      note "스킬 공격 유형(참격) 분류가 고정 어휘에 없어 참격 조건과 피해량 증가를 엔진 구현으로 넘김"
    }
  }
}
